# Contoh environment variable untuk Render (isi lewat dashboard, JANGAN di-commit sebagai .env)
APP_NAME="Baby Cry IoT"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_HASIL_php_artisan_key:generate_--show
APP_DEBUG=false
APP_URL=https://NAMA-APLIKASI.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database Neon (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=ep-xxxxxxxx.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=GANTI_PASSWORD_NEON

# Tidak memakai database untuk session/cache/queue
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Opsional: lindungi POST/PUT/DELETE dengan header X-API-KEY (kosongkan saat awal pengujian)
IOT_API_KEY=

# true = isi 15 data contoh saat start pertama (aman, tidak duplikat)
RUN_SEED=true
